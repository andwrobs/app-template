{
  "name": "app-reference",
  "private": true,
  "type": "module",
  "workspaces": ["framework"],
  "engines": { "node": ">=22.22.0" },
  "scripts": {
    "typecheck": "tsc --project tsconfig.json",
    "test": "vitest run",
    "docs:sync": "python3 sync-docs.py",
    "docs:check": "python3 sync-docs.py --check",
    "check:data": "npm run typecheck && npm test",
    "check:framework": "npm run typecheck --workspace app-reference-framework && npm run build --workspace app-reference-framework",
    "check": "npm run docs:check && npm run check:data && npm run check:framework",
    "archive": "python3 scripts/package-reference.py"
  },
  "dependencies": {
    "@tanstack/react-form": "1.33.5",
    "@tanstack/react-query": "5.104.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-router": "8.4.0",
    "zod": "4.4.3",
    "zustand": "5.0.14"
  },
  "devDependencies": {
    "@testing-library/dom": "10.4.1",
    "@testing-library/react": "16.3.2",
    "@types/node": "25.9.1",
    "@types/react": "19.2.16",
    "@types/react-dom": "19.2.3",
    "jsdom": "29.1.1",
    "typescript": "6.0.3",
    "vite": "8.0.16",
    "vitest": "4.1.8"
  }
}
