{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["vite/client"],
    "verbatimModuleSyntax": true,
    "noUncheckedIndexedAccess": true,
    "paths": { "~/*": ["./src/*"] }
  },
  "include": ["src", "test-utils"]
}
